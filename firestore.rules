rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ ฟังก์ชันตรวจสอบ Role (ใช้ Custom Claims เป็นหลักเพื่อลด Quota Read, ไม่ Fallback ไปหา DB แล้วเพื่อป้องกัน Read Cost มหาศาลจาก User ทั่วไป)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role in ['staff', 'manager', 'admin', 'owner', 'vp', 'vp 1', 'VP 1', 'Staff', 'Manager', 'Admin', 'Owner', 'VP', 'packer', 'Packer', 'พนักงานทั่วไป', 'ช่าง', 'พนักงานแพ็ค', 'บัญชี', 'แอดมิน', 'ผู้จัดการ', 'เจ้าของ'] ||
        request.auth.token.isStaff == true ||
        (request.auth.token.email in ['dh1notebook@gmail.com', 'dh2notebook@gmail.com', 'zhoulinjuan1@gmail.com', 'bentshan@gmail.com'] && request.auth.token.email_verified == true) ||
        request.auth.uid == '8rP6WhimrqOILBId86bkTsvNHFf1' || // System Admin UID fallback
        (
          // 🛡️ ป้องกัน Quota Read รั่วไหล: รัน DB Fallback เฉพาะผู้ใช้เก่าที่ยังไม่ได้รับ Custom Claims บน Token เท่านั้น
          !('role' in request.auth.token) && !('isStaff' in request.auth.token) &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStaff == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'manager', 'admin', 'owner', 'vp', 'vp 1', 'Staff', 'Manager', 'Admin', 'Owner', 'VP', 'VP 1', 'packer', 'Packer', 'พนักงานทั่วไป', 'ช่าง', 'พนักงานแพ็ค', 'บัญชี', 'แอดมิน', 'ผู้จัดการ', 'เจ้าของ']
          )
        )
      );
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['manager', 'admin', 'owner', 'vp', 'vp 1', 'VP 1', 'Manager', 'Admin', 'Owner', 'VP', 'ผู้จัดการ', 'เจ้าของ', 'แอดมิน'] ||
        (request.auth.token.email in ['dh1notebook@gmail.com', 'dh2notebook@gmail.com', 'zhoulinjuan1@gmail.com', 'bentshan@gmail.com'] && request.auth.token.email_verified == true) ||
        request.auth.uid == '8rP6WhimrqOILBId86bkTsvNHFf1' || // System Admin UID fallback
        (
          // 🛡️ ป้องกัน Quota Read รั่วไหล: รัน DB Fallback เฉพาะผู้ใช้เก่าที่ยังไม่ได้รับ Custom Claims บน Token เท่านั้น
          !('role' in request.auth.token) &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['manager', 'admin', 'owner', 'vp', 'vp 1', 'Manager', 'Admin', 'Owner', 'VP', 'VP 1', 'ผู้จัดการ', 'เจ้าของ', 'แอดมิน']
          )
        )
      );
    }
    
    // ============================================
    // 🌟 กฎของ Collections ต่างๆ
    // ============================================

    // 1. ผู้ใช้ (Users)
    match /users/{userId} {
      // สงวนสิทธิ์การอ่านข้อมูลส่วนบุคคลเฉพาะเจ้าของและพนักงานเท่านั้น (PDPA Compliance)
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      
      // 🚀 THE FIX: ป้องกันการแฮกยกระดับสิทธิ์และแก้ไขยอดเงิน (Escalation of Privilege & Financial Fraud)
      allow create: if isStaff() || (
        isAuthenticated() && request.auth.uid == userId &&
        (
          !request.resource.data.keys().hasAny(['email']) ||
          request.resource.data.email == request.auth.token.email
        ) &&
        (
          !request.resource.data.keys().hasAny(['walletBalance', 'creditPoints', 'totalAccumulatedPoints']) ||
          (
            request.resource.data.get('walletBalance', 0) == 0 &&
            request.resource.data.get('creditPoints', 0) == 0 &&
            request.resource.data.get('totalAccumulatedPoints', 0) == 0
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['role', 'isStaff', 'isApproved', 'roles', 'userType']) ||
          (
            request.resource.data.get('role', 'Customer') in ['user', 'customer', 'retail', 'pending_approval', 'pending', 'Customer', 'User', 'Retail'] &&
            request.resource.data.get('isStaff', false) == false &&
            request.resource.data.get('isApproved', false) == false &&
            !request.resource.data.keys().hasAny(['roles', 'userType'])
          )
        )
      );
      allow update: if isManagerOrAdmin() || (
        isStaff() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isStaff', 'uid', 'email', 'rank', 'accountId', 'customerCode', 'roles', 'userType',
          'pendingWithdrawal',
          'status', 'isActive', 'isApproved'
        ])) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'lastWalletTxId']) ||
          (
            request.resource.data.get('walletBalance', 0) < resource.data.get('walletBalance', 0) &&
            request.resource.data.get('walletBalance', 0) >= 0 &&
            existsAfter(/databases/$(database)/documents/users/$(userId)/wallet_transactions/$(request.resource.data.lastWalletTxId))
          )
        )
      ) || (
        isAuthenticated() && request.auth.uid == userId &&
        (
          // Allow setting or requesting pending_approval / pending status for oneself if isStaff remains false
          (
            request.resource.data.role in ['pending_approval', 'pending', 'user', 'customer'] &&
            request.resource.data.get('isStaff', false) == false &&
            request.resource.data.get('isApproved', false) == false &&
            request.resource.data.get('isActive', false) == false &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'creditPoints', 'totalAccumulatedPoints', 'walletBalance', 'pendingWithdrawal',
              'rank', 'accountId', 'customerCode', 'roles', 'userType', 'status', 'stats'
            ])
          ) ||
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role', 'isStaff', 'isApproved', 'uid', 'email', 'creditPoints', 'totalAccumulatedPoints', 
              'rank', 'accountId', 'customerCode', 'isActive', 'status', 'roles', 'userType', 'permissions'
            ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stats']) || (
              request.resource.data.get('stats', {}).diff(resource.data.get('stats', {})).affectedKeys().hasOnly(['lastOrderDate', 'lastPurchaseDate', 'lastCheckoutAttempt'])
            )) &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'pendingWithdrawal', 'lastWalletTxId']) ||
              (
                request.resource.data.get('walletBalance', 0) < resource.data.get('walletBalance', 0) &&
                request.resource.data.get('walletBalance', 0) >= 0 &&
                existsAfter(/databases/$(database)/documents/users/$(userId)/wallet_transactions/$(request.resource.data.lastWalletTxId)) &&
                (
                  request.resource.data.get('pendingWithdrawal', 0) == resource.data.get('pendingWithdrawal', 0) ||
                  request.resource.data.get('pendingWithdrawal', 0) == resource.data.get('pendingWithdrawal', 0) + (resource.data.get('walletBalance', 0) - request.resource.data.get('walletBalance', 0))
                )
              )
            )
          )
        )
      );
      
      // 🛡️ ปลอดภัยระดับสูงสุด: แยกแยะสิทธิ์ Subcollections ป้องกันการแก้ไขประวัติธุรกรรมและการแฮก Legacy Wallet
      match /wallet_transactions/{txId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        // 🚀 THE FIX: อนุญาตให้ลูกค้าระบุยอดตัด Wallet ตอนสั่งซื้อ โดยเช็คว่ายอดหักตรงกับ walletBalance ที่ลดลงจริงใน users
        allow create: if isStaff() || (
          isAuthenticated() && request.auth.uid == userId &&
          request.resource.data.type == 'SPEND' &&
          request.resource.data.amount > 0 &&
          request.resource.data.status == 'SUCCESS' &&
          request.resource.data.transactionId == txId &&
          request.resource.data.keys().hasAll(['transactionId', 'type', 'amount', 'balanceAfter', 'status', 'timestamp']) &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          request.resource.data.balanceAfter == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('walletBalance', 0)
        );
        // 🛡️ บัญชีธุรกรรมการเงินต้องเป็น Immutable หรือจัดการโดยผู้จัดการ/แอดมินเท่านั้น ห้ามพนักงานทั่วไปแก้ไขหรือลบ
        allow update, delete: if isManagerOrAdmin();
      }
      match /historyLogs/{logId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if isStaff();
      }
      match /private/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
      match /hardware_scans/{scanId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
      match /wallet/{walletId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        allow write: if isStaff();
      }
      match /storeProfile/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
    }
    
    // 1.1 ผู้ใช้ (Users) ในระบบ Artifacts
    match /artifacts/{appId}/users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow create: if isStaff() || (
        isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['role', 'isStaff', 'roles', 'userType', 'walletBalance', 'creditPoints', 'totalAccumulatedPoints', 'isApproved'])
      );
      allow update: if isManagerOrAdmin() || (
        isStaff() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isStaff', 'uid', 'email', 'rank', 'accountId', 'customerCode', 'roles', 'userType',
          'walletBalance', 'creditPoints', 'totalAccumulatedPoints', 'pendingWithdrawal',
          'status', 'isActive', 'isApproved'
        ]))
      ) || (
        isAuthenticated() && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isStaff', 'uid', 'email', 'creditPoints', 'totalAccumulatedPoints', 
          'rank', 'accountId', 'customerCode', 'isActive', 'status', 'roles', 'userType'
        ])) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stats']) || (
          request.resource.data.get('stats', {}).diff(resource.data.get('stats', {})).affectedKeys().hasOnly(['lastOrderDate', 'lastPurchaseDate', 'lastCheckoutAttempt'])
        )) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'pendingWithdrawal', 'lastWalletTxId']) ||
          (
            request.resource.data.get('walletBalance', 0) < resource.data.get('walletBalance', 0) &&
            request.resource.data.get('walletBalance', 0) >= 0 &&
            existsAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/wallet_transactions/$(request.resource.data.lastWalletTxId)) &&
            (
              request.resource.data.get('pendingWithdrawal', 0) == resource.data.get('pendingWithdrawal', 0) ||
              request.resource.data.get('pendingWithdrawal', 0) == resource.data.get('pendingWithdrawal', 0) + (resource.data.get('walletBalance', 0) - request.resource.data.get('walletBalance', 0))
            )
          )
        )
      );
      
      // 🛡️ ปลอดภัยระดับสูงสุดสำหรับระบบ Artifacts
      match /wallet_transactions/{txId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        // 🚀 THE FIX: อนุญาตให้ลูกค้าระบุยอดตัด Wallet ตอนสั่งซื้อ โดยเช็คว่ายอดหักตรงกับ walletBalance ที่ลดลงจริงใน users
        allow create: if isStaff() || (
          isAuthenticated() && request.auth.uid == userId &&
          request.resource.data.type == 'SPEND' &&
          request.resource.data.amount > 0 &&
          request.resource.data.status == 'SUCCESS' &&
          request.resource.data.transactionId == txId &&
          request.resource.data.keys().hasAll(['transactionId', 'type', 'amount', 'balanceAfter', 'status', 'timestamp']) &&
          existsAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)) &&
          request.resource.data.balanceAfter == getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)).data.get('walletBalance', 0)
        );
        // 🛡️ บัญชีธุรกรรมการเงินต้องเป็น Immutable หรือจัดการโดยผู้จัดการ/แอดมินเท่านั้น ห้ามพนักงานทั่วไปแก้ไขหรือลบ
        allow update, delete: if isManagerOrAdmin();
      }
      match /private/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
      match /hardware_scans/{scanId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
      match /wallet/{walletId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        allow write: if isStaff();
      }
      match /storeProfile/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
    }

    // 2.0 แคตตาล็อกและสารบัญค้นหา (Catalogs & Search Index)
    match /catalogs/{docId} {
      // 🛡️ Public Catalog Artifacts: อนุญาตให้อ่านเฉพาะแคชสาธารณะสำหรับหน้าร้านลูกค้า
      // เอกสารภายใน, ราคาทุน และ search_index (search_index_p*) สงวนสิทธิ์เฉพาะ isStaff()
      allow read: if (
        docId.matches('^cat_.*') ||
        docId == 'home_chunk' ||
        docId == 'home_showcase' ||
        docId.matches('^home_showcase_[0-9]+$') ||
        docId == 'categories_index' ||
        docId == 'ad_cards_bundle'
      ) || isStaff();
      allow write: if isStaff();
    }

    // 2. สินค้าคงคลัง (Products)
    match /products/{productId} {
      // ลูกค้าทั่วไปอ่านได้
      allow read: if true;
      // เฉพาะพนักงานเท่านั้นที่แก้ไขจำนวนสต๊อก หรือข้อมูลทั้งหมดได้
      allow write: if isStaff();
      // 🚀 THE FIX (Inventory DoS & Review IDOR Hardened): แยกส่วนตรวจสอบ Review และ Stock ให้รัดกุม
      allow update: if isStaff() || (isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewCount', 'averageRating', 'stockQuantity', 'variants', 'stats', 'lastOrderId', 'updatedAt']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewCount', 'averageRating']) ||
          (
            request.resource.data.get('reviewCount', 0) == resource.data.get('reviewCount', 0) + 1 &&
            request.resource.data.get('averageRating', 0) >= 1.0 &&
            request.resource.data.get('averageRating', 0) <= 5.0
          )
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockQuantity']) || 
          (
            request.resource.data.get('stockQuantity', 0) >= 0 &&
            request.resource.data.get('stockQuantity', 0) < resource.data.get('stockQuantity', 0) &&
            existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)) &&
            getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.userId == request.auth.uid &&
            request.resource.data.get('stockQuantity', 0) == (resource.data.get('stockQuantity', 0) - (request.resource.data.get('stats', {}).get('sold', 0) - resource.data.get('stats', {}).get('sold', 0)))
          )
        )
      );
    }
    
    // 2.2 คลังรูปภาพ (Gallery Images)
    match /gallery_images/{imageId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 🛡️ POS Order Idempotency Lock Collection
    match /order_requests/{reqKey} {
      allow read, write: if isStaff();
    }

    // 3. ระบบบิลและการเงิน (Orders & Credit)
    match /orders/{orderId} {
      // 🛡️ Short-circuit customer ownership before isStaff() to eliminate spurious DB reads for customers lacking claims
      allow read: if (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.customer.uid == request.auth.uid)) || isStaff();
      // 🚀 THE FIX: อนุญาตให้สร้างออเดอร์โดยจำกัดสถานะ แต่ลบเพดาน pendingCredits ออกเพราะ Backoffice จะคำนวณใหม่เสมอ (Zero-Trust)
      allow create: if isStaff() || (
        isAuthenticated() && request.auth.uid == request.resource.data.userId &&
        (!request.resource.data.keys().hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'pending') &&
        (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['pending', 'pending_payment', 'pending_payment_verification']) &&
        (!request.resource.data.keys().hasAny(['orderStatus']) || request.resource.data.orderStatus in ['pending', 'pending_payment', 'pending_payment_verification']) &&
        (!request.resource.data.keys().hasAny(['isPaid']) || request.resource.data.isPaid == false) &&
        (!request.resource.data.keys().hasAny(['pendingCredits']) || request.resource.data.pendingCredits >= 0) &&
        (!request.resource.data.keys().hasAny(['totals']) || request.resource.data.totals.netTotal >= 0)
      );
      allow update: if isStaff() || (
        isAuthenticated() && resource.data.userId == request.auth.uid &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderStatus', 'receivedAt', 'cancelledBy', 'cancelledAt', 'updatedAt', 'pendingCredits', 'paymentSlipUrl']) &&
            (
              (request.resource.data.status == 'received' && resource.data.status in ['shipped', 'completed', 'approved', 'paid']) ||
              (request.resource.data.status == 'cancelled' && resource.data.status in ['pending', 'pending_payment']) ||
              (request.resource.data.status == 'pending_payment_verification' && resource.data.status in ['pending', 'pending_payment', 'pending_payment_verification'])
            )
          ) ||
          (
            // 🛡️ PDPA Right to Erasure: อนุญาตให้เจ้าของออเดอร์เซ็นเซอร์ข้อมูลส่วนบุคคลของตัวเองในออเดอร์เก่าได้ (ห้ามแก้ข้อมูลการเงิน)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customer', 'updatedAt']) &&
            request.resource.data.customer.displayName == 'ผู้ใช้งานที่ถูกลบ' &&
            request.resource.data.customer.phone == ''
          )
        )
      );
      allow delete: if isManagerOrAdmin() && resource.data.get('status', resource.data.get('orderStatus', '')) in ['draft', 'pending', 'Draft', 'Pending'];
    }

    match /credit_transactions/{txId} {
      // ลูกค้าดูประวัติเครดิตตัวเองได้ หรือพนักงานดูได้ทั้งหมด
      allow read: if isStaff() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      // 🔒 Immutability Guard: อนุญาตเฉพาะสร้างรายการใหม่ (Append-Only) ห้ามแก้ไขหรือลบประวัติการเงิน
      allow create: if isStaff() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    // 3.1 ธุรกรรมสต๊อกและประวัติการเคลื่อนไหวสินค้ากลาง (Canonical Transactions Ledger)
    match /transactions/{txId} {
      // พนักงานดูได้ทั้งหมด หรือลูกค้าดูเฉพาะธุรกรรมที่ตนเองสร้างได้
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.createdBy == request.auth.uid));
      // อนุญาตให้พนักงาน หรือลูกค้า (กดยกเลิกออเดอร์หน้าร้าน) สร้างได้
      allow create: if isStaff() || (isAuthenticated() && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isStaff();
    }

    match /claim_locks/{lockId} {
      allow read, write: if isStaff();
    }

    match /return_locks/{lockId} {
      allow read, write: if isStaff();
    }

    // 4. งานอนุมัติของ Manager (Todos & System Logs)
    match /todos/{todoId} {
      allow read: if isStaff() || (isAuthenticated() && (
        resource == null ||
        resource.data.createdByUid == request.auth.uid || 
        resource.data.createdBy == request.auth.uid || 
        resource.data.customerUid == request.auth.uid || 
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      ));
      allow create: if isStaff() || (isAuthenticated() && (
        request.resource.data.createdByUid == request.auth.uid || 
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.targetUid == request.auth.uid ||
        request.resource.data.partnerId == request.auth.uid
      ) && (
        // 🚀 THE FIX: บังคับสถานะ Todo ให้เป็น pending หรือ todo เท่านั้น ป้องกันแฮกสร้างงานที่ผ่านการอนุมัติแล้ว
        request.resource.data.status in ['todo', 'pending', 'pending_manager', 'waiting_item', 'PENDING']
      ) && (
        // 🛡️ ป้องกันแฮกเกอร์แอบสร้างงานสงวนสิทธิ์ของพนักงาน/ผู้จัดการ (อนุญาตเฉพาะ STAFF_APPROVAL หรือ PRODUCT_KNOWLEDGE_APPROVAL ที่มีแต้มรางวัล <= 2)
        (
          !(request.resource.data.get('taskType', '') in [
            'CLAIM_APPROVAL', 'EXCHANGE_APPROVAL', 'RETURN_APPROVAL', 'CANCEL_CLAIM_APPROVAL', 
            'CANCEL_EXCHANGE_APPROVAL', 'CANCEL_RETURN_APPROVAL', 'PRODUCT_DELETE_APPROVAL', 
            'PARTNER_APPROVAL', 'PRODUCT_KNOWLEDGE_APPROVAL', 'BILL_CANCEL_APPROVAL',
            'WALLET_WITHDRAWAL', 'LEAVE_APPROVAL'
          ]) &&
          !(request.resource.data.get('type', '') in [
            'CLAIM_APPROVAL', 'EXCHANGE_APPROVAL', 'RETURN_APPROVAL', 'CANCEL_CLAIM_APPROVAL', 
            'CANCEL_EXCHANGE_APPROVAL', 'CANCEL_RETURN_APPROVAL', 'PRODUCT_DELETE_APPROVAL', 
            'PARTNER_APPROVAL', 'PRODUCT_KNOWLEDGE_APPROVAL', 'BILL_CANCEL_APPROVAL',
            'WALLET_WITHDRAWAL', 'LEAVE_APPROVAL'
          ])
        ) || (
          (request.resource.data.get('taskType', '') == 'PRODUCT_KNOWLEDGE_APPROVAL' ||
           request.resource.data.get('type', '') == 'PRODUCT_KNOWLEDGE_APPROVAL') &&
          (!('payload' in request.resource.data) ||
           !('creditReward' in request.resource.data.payload) ||
           request.resource.data.payload.creditReward <= 2)
        )
      ));
      allow update: if isManagerOrAdmin() || (isStaff() && (
        !(resource.data.get('taskType', '') in [
          'CLAIM_APPROVAL', 'EXCHANGE_APPROVAL', 'RETURN_APPROVAL', 'CANCEL_CLAIM_APPROVAL', 
          'CANCEL_EXCHANGE_APPROVAL', 'CANCEL_RETURN_APPROVAL', 'PRODUCT_DELETE_APPROVAL', 'STAFF_APPROVAL', 
          'PARTNER_APPROVAL', 'PRODUCT_KNOWLEDGE_APPROVAL', 'BILL_CANCEL_APPROVAL',
          'WALLET_WITHDRAWAL', 'LEAVE_APPROVAL'
        ]) &&
        !(resource.data.get('type', '') in [
          'CLAIM_APPROVAL', 'EXCHANGE_APPROVAL', 'RETURN_APPROVAL', 'CANCEL_CLAIM_APPROVAL', 
          'CANCEL_EXCHANGE_APPROVAL', 'CANCEL_RETURN_APPROVAL', 'PRODUCT_DELETE_APPROVAL', 'STAFF_APPROVAL', 
          'PARTNER_APPROVAL', 'PRODUCT_KNOWLEDGE_APPROVAL', 'BILL_CANCEL_APPROVAL',
          'WALLET_WITHDRAWAL', 'LEAVE_APPROVAL'
        ])
      )) || (isAuthenticated() && (
        resource == null ||
        resource.data.createdByUid == request.auth.uid || 
        resource.data.createdBy == request.auth.uid || 
        resource.data.customerUid == request.auth.uid || 
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.partnerId == request.auth.uid
      ) && (
        // 🚀 THE FIX: กรณีคำร้องโฆษณา/นามบัตร พาร์ทเนอร์แก้ไขรายละเอียดเพื่อส่งตรวจใหม่ได้ โดยสถานะต้องคงเป็น pending
        (
          resource.data.get('type', '') in ['AD_APPROVAL', 'USER_SKU_APPROVAL', 'BILLBOARD_APPROVAL', 'APPROVE_PARTNER_AD', 'APPROVE_BILLBOARD_AD', 'BUSINESS_CARD_AD_APPROVAL'] &&
          request.resource.data.get('status', 'pending') in ['pending', 'PENDING', 'todo'] &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'completedAt', 'type', 'taskType'])
        ) ||
        // กรณีงานทั่วไป: ห้ามแก้สถานะ, จำนวนเงิน, และเนื้อหางานหลังสร้างเสร็จ
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'type', 'amount', 'completedAt', 'title', 'description', 'taskType'])
      ));
      allow delete: if isStaff() || (isAuthenticated() && (
        resource == null ||
        resource.data.createdByUid == request.auth.uid || 
        resource.data.createdBy == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      ));
    }
    
    // 4.1 สินค้ายังไม่มีจำหน่าย (Sourcing Requests)
    match /sourcing_requests/{reqId} {
      // 🛡️ คุ้มครองข้อมูลส่วนบุคคล (PII & IDOR Protection): สงวนสิทธิ์การอ่านเฉพาะเจ้าของคำขอหรือพนักงานร้านเท่านั้น
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.createdByUid == request.auth.uid));
      allow create: if isAuthenticated() || isStaff();
      allow update: if isStaff() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.createdByUid == request.auth.uid));
      allow delete: if isStaff() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.createdByUid == request.auth.uid));
    }

    match /claims/{claimId} {
      allow read: if isStaff() || (isAuthenticated() && (
        resource == null ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.createdByUid == request.auth.uid ||
        resource.data.requestedBy == request.auth.uid ||
        (('payload' in resource.data) && resource.data.payload.customerUid == request.auth.uid)
      ));
      allow create: if isStaff() || (isAuthenticated() && (
        request.resource.data.customerUid == request.auth.uid ||
        request.resource.data.createdByUid == request.auth.uid ||
        request.resource.data.requestedBy == request.auth.uid ||
        (('payload' in request.resource.data) && request.resource.data.payload.customerUid == request.auth.uid)
      ) && (
        !('status' in request.resource.data) || 
        request.resource.data.status in ['pending_manager', 'pending']
      ));
      allow update: if isManagerOrAdmin() || (
        isStaff() && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['type', 'amount']) ||
           (request.resource.data.type in ['CANCEL_CLAIM_APPROVAL', 'CANCEL_EXCHANGE_APPROVAL', 'CANCEL_RETURN_APPROVAL'] &&
            request.resource.data.status == 'pending_manager' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']))) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || 
           request.resource.data.status in ['pending_manager', 'approved', 'arrived', 'processing'])
        )
      ) || (isAuthenticated() && (
        resource == null ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.createdByUid == request.auth.uid ||
        resource.data.requestedBy == request.auth.uid ||
        (('payload' in resource.data) && resource.data.payload.customerUid == request.auth.uid)
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'type', 'amount', 'payload']) ||
        (
          resource.data.status == 'waiting_item' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'type', 'amount']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'updatedAt', 'trackingNo'])
        )
      ));
      allow delete: if isManagerOrAdmin();
    }
    
    // 4.2 ประวัติการรับเข้าสต๊อก (Stock Receipts)
    match /stock_receipts/{receiptId} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff() || (
        isAuthenticated() && 
        request.resource.data.source == 'checkout_order' &&
        request.resource.data.createdBy == request.auth.uid
      );
    }
    
    // 4.3 ประวัติการนำเข้าไฟล์สต๊อก (Import Batches)
    match /import_batches/{batchId} {
      allow read, write: if isStaff();
    }
    match /inventory_import_batches/{batchId} {
      allow read, write: if isStaff();
    }

    // 4.4 ประวัติการปรับปรุงสต๊อก (Stock Adjustments)
    match /stock_adjustments/{adjId} {
      allow read, write: if isStaff();
    }
    
    match /system_logs/{logId} {
      allow read: if isManagerOrAdmin();
      allow write: if isManagerOrAdmin();
      allow create: if isAuthenticated() && (
        request.resource.data.get('category', '') in ['client_error', 'client_warning', 'telemetry', 'ERROR', 'error', 'Marketing', 'marketing'] ||
        request.resource.data.get('module', '') in ['Marketing', 'marketing']
      );
    }
    
    // 🛡️ Admin Audits & Idempotency Locks
    match /admin_audits/{auditId} {
      allow read: if isManagerOrAdmin();
      allow create: if isStaff();
      allow update, delete: if isManagerOrAdmin();
    }
    match /wallet_requests/{lockKey} {
      allow read, write: if isStaff();
    }
    match /returns/{returnId} {
      allow read, write: if isStaff();
    }
    match /yearly_archives/{archiveId} {
      allow read: if isStaff();
      allow write: if isManagerOrAdmin();
    }
    // 🛡️ ปลดล็อก Workflow รีวิวร้านค้าคู่ค้า: อนุญาตให้เจ้าของร้านตอบกลับ (ownerReply) หรือกดไลก์ (ownerLiked) รีวิวในร้านตนเองได้
    match /partner_reviews/{partnerId}/comments/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', request.auth.uid) == request.auth.uid ||
        isStaff()
      );
      allow update: if isStaff() || (
        isAuthenticated() && request.auth.uid == partnerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerLiked', 'ownerReply'])
      );
      allow delete: if isStaff();
    }
    match /partner_reviews/{document=**} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', request.auth.uid) == request.auth.uid ||
        isStaff()
      );
      allow update, delete: if isStaff();
    }
    
    // 🚀 THE FIX: อนุญาตให้ระบบ Outbox ทำงานได้สำหรับพนักงาน แต่ลบไม่ได้
    match /gas_outbox/{logId} {
      allow read: if isManagerOrAdmin();
      allow create: if isStaff();
      allow update, delete: if isManagerOrAdmin();
    }

    match /history_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManagerOrAdmin();
    }

    match /history_logs_daily/{dateDoc} {
      allow read, write: if isStaff();
    }

    // 🛡️ บันทึกเวลาเข้า-ออกงานพนักงาน (Staff QR Attendance Logs)
    match /attendance_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() && (
        request.resource.data.staffUid == request.auth.uid || isManagerOrAdmin()
      );
      allow update, delete: if isManagerOrAdmin();
    }
    
    // 🛡️ POS Order Idempotency Lock Collection in Artifacts
    match /artifacts/{appId}/order_requests/{reqKey} {
      allow read, write: if isStaff();
    }
    
    match /artifacts/{appId}/history_logs_daily/{dateDoc} {
      allow read, write: if isStaff();
    }
    
    match /artifacts/{appId}/system_logs/{logId} {
      allow read: if isManagerOrAdmin();
      allow write: if isManagerOrAdmin();
      allow create: if isAuthenticated() && (
        request.resource.data.get('category', '') in ['client_error', 'client_warning', 'telemetry', 'ERROR', 'error', 'Marketing', 'marketing'] ||
        request.resource.data.get('module', '') in ['Marketing', 'marketing']
      );
    }

    match /artifacts/{appId}/attendance_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() && (
        request.resource.data.staffUid == request.auth.uid || isManagerOrAdmin()
      );
      allow update, delete: if isManagerOrAdmin();
    }

    // 5. ข้อมูลอื่นๆ ที่เป็น Public (หมวดหมู่, หน้าแรก, โฆษณา)
    match /artifacts/{appId}/public/{document=**} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        !request.resource.data.keys().hasAny(['ownerId', 'createdBy']) ||
        request.resource.data.get('ownerId', request.auth.uid) == request.auth.uid ||
        request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
      );
      allow update, delete: if isStaff();
    }
    match /homepage_categories/{catId} {
      allow read: if true;
      allow write: if isManagerOrAdmin();
    }
    match /partners/{partnerId} {
      allow read: if true;
      allow create: if isStaff() || (isAuthenticated() && request.auth.uid == partnerId && !request.resource.data.keys().hasAny(['isVerified', 'isActive', 'commissionRate']));
      allow update: if isStaff() || (isAuthenticated() && request.auth.uid == partnerId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'isActive', 'commissionRate']));
      allow delete: if isManagerOrAdmin();
    }
    match /ActivePartners/{partnerId} {
      allow read: if true;
      allow create, update: if isManagerOrAdmin();
      allow delete: if isManagerOrAdmin() || (isAuthenticated() && request.auth.uid == partnerId);
    }
    match /promotions/{promoId} {
      allow read: if true;
      allow create, delete: if isManagerOrAdmin();
      allow update: if isManagerOrAdmin() || isStaff() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotaUsed']) &&
        request.resource.data.get('quotaUsed', 0) == resource.data.get('quotaUsed', 0) + 1 &&
        (!('quotaLimit' in resource.data) || resource.data.quotaLimit == null || resource.data.quotaLimit == 0 || request.resource.data.get('quotaUsed', 0) <= resource.data.quotaLimit)
      );
    }
    match /freebies/{freebieId} {
      allow read: if true;
      allow create, delete: if isManagerOrAdmin();
      allow update: if isManagerOrAdmin() || isStaff() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotaUsed']) &&
        request.resource.data.get('quotaUsed', 0) >= resource.data.get('quotaUsed', 0) + 1 &&
        request.resource.data.get('quotaUsed', 0) <= resource.data.get('quotaUsed', 0) + 10 &&
        (!('quotaLimit' in resource.data) || resource.data.quotaLimit == null || resource.data.quotaLimit == 0 || request.resource.data.get('quotaUsed', 0) <= resource.data.quotaLimit)
      );
    }
    
    // 5.1 ข้อมูลโฆษณาต่างๆ (Ads)
    match /partner_ads/{adId} {
      allow read: if true;
      allow create: if isStaff() || (
        isAuthenticated() && request.resource.data.ownerId == request.auth.uid &&
        (!request.resource.data.keys().hasAny(['status', 'isActive']) || request.resource.data.status in ['pending', 'PENDING'])
      );
      allow update: if isStaff() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid && (
          // กรณีที่ 1: พาร์ทเนอร์กด พักแคมเปญ (paused) หรือ เปิดใช้งานต่อ (active) สำหรับโฆษณาที่เคยอนุมัติแล้วเท่านั้น
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isActive', 'updatedAt']) &&
            resource.data.status in ['active', 'paused', 'ACTIVE', 'PAUSED'] &&
            request.resource.data.status in ['active', 'paused', 'ACTIVE', 'PAUSED'] &&
            request.resource.data.isActive == (request.resource.data.status in ['active', 'ACTIVE'])
          ) ||
          // กรณีที่ 2: พาร์ทเนอร์แก้ไขเนื้อหาโฆษณา หรือส่งตรวจใหม่ (pending) ห้ามแตะต้องฟิลด์การเงินและสถิติ
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'impressions', 'clicks', 'totalSpent', 'remainingBudget', 'approvedAt', 'approvedBy', 'stats', 'spentBudget', 'ownerId'
            ]) && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isActive']) ||
              (request.resource.data.status in ['pending', 'PENDING'] && request.resource.data.isActive == false)
            )
          )
        )
      );
      allow delete: if isStaff() || (isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid));
    }
    match /billboard_ads/{adId} {
      allow read: if true;
      allow create: if isStaff() || (
        isAuthenticated() && request.resource.data.ownerId == request.auth.uid &&
        (!request.resource.data.keys().hasAny(['status', 'isActive']) || request.resource.data.status in ['pending', 'PENDING'])
      );
      allow update: if isStaff() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid && (
          // กรณีที่ 1: พาร์ทเนอร์กด พักแคมเปญ (paused) หรือ เปิดใช้งานต่อ (active) สำหรับโฆษณาที่เคยอนุมัติแล้วเท่านั้น
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isActive', 'updatedAt']) &&
            resource.data.status in ['active', 'paused', 'ACTIVE', 'PAUSED'] &&
            request.resource.data.status in ['active', 'paused', 'ACTIVE', 'PAUSED'] &&
            request.resource.data.isActive == (request.resource.data.status in ['active', 'ACTIVE'])
          ) ||
          // กรณีที่ 2: พาร์ทเนอร์แก้ไขเนื้อหาโฆษณา หรือส่งตรวจใหม่ (pending) ห้ามแตะต้องฟิลด์การเงินและสถิติ
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'impressions', 'clicks', 'totalSpent', 'remainingBudget', 'approvedAt', 'approvedBy', 'stats', 'spentBudget', 'ownerId'
            ]) && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isActive']) ||
              (request.resource.data.status in ['pending', 'PENDING'] && request.resource.data.isActive == false)
            )
          )
        )
      );
      allow delete: if isStaff() || (isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid));
    }
    match /user_sku_ads/{adId} {
      allow read: if true;
      allow create: if isStaff() || (
        isAuthenticated() && request.resource.data.ownerId == request.auth.uid &&
        (!request.resource.data.keys().hasAny(['status', 'isActive']) || request.resource.data.status in ['pending', 'PENDING'])
      );
      allow update: if isStaff() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid && (
          // กรณีที่ 1: พาร์ทเนอร์กด พักแคมเปญ (paused) หรือ เปิดใช้งานต่อ (active) สำหรับโฆษณาที่เคยอนุมัติแล้วเท่านั้น
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isActive', 'updatedAt']) &&
            resource.data.status in ['active', 'paused', 'ACTIVE', 'PAUSED'] &&
            request.resource.data.status in ['active', 'paused', 'ACTIVE', 'PAUSED'] &&
            request.resource.data.isActive == (request.resource.data.status in ['active', 'ACTIVE'])
          ) ||
          // กรณีที่ 2: พาร์ทเนอร์แก้ไขเนื้อหาโฆษณา หรือส่งตรวจใหม่ (pending) ห้ามแตะต้องฟิลด์การเงินและสถิติ
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'impressions', 'clicks', 'totalSpent', 'remainingBudget', 'approvedAt', 'approvedBy', 'stats', 'spentBudget', 'ownerId'
            ]) && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isActive']) ||
              (request.resource.data.status in ['pending', 'PENDING'] && request.resource.data.isActive == false)
            )
          )
        )
      );
      allow delete: if isStaff() || (isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid));
    }
    
    // 6. การตั้งค่าระบบ (Settings) และข้อมูลพื้นฐาน
    match /carts/{cartId} {
      allow read, write: if isAuthenticated() && request.auth.uid == cartId;
    }
    match /shipping_rules/{docId} {
      allow read: if true;
      allow write: if isManagerOrAdmin();
    }
    match /sync_mappings/{docId} {
      allow read: if isStaff();
      allow write: if isManagerOrAdmin();
    }
    match /settings/{docId} {
      // อนุญาตให้อ่าน settings ทั่วไปได้ แต่จำกัดสิทธิ์อ่าน credit_config เฉพาะผู้ใช้งานที่ล็อกอินแล้ว
      allow read: if docId != 'credit_config' || isAuthenticated();
      allow write: if isManagerOrAdmin() || (isStaff() && (
        docId == 'bigseller_templates' ||
        docId == 'inventory_meta' ||
        (docId == 'credit_config' && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'adClickCost', 'adImpressionCost', 'adImpressionCount', 'adMinBudget', 'rules'
          ]) &&
          (!request.resource.data.keys().hasAll(['config']) || 
           !request.resource.data.config.diff(resource.data.config).affectedKeys().hasAny([
            'adClickCost', 'adImpressionCost', 'adImpressionCount', 'adMinBudget', 'rules'
          ]))
        )
      ));
    }
    
    match /system_config/{docId} {
      // ป้องกันการเข้าถึง Token/Secret ยกเว้น Manager
      allow read, write: if isManagerOrAdmin();
    }
    
    match /counters/{counterId} {
      allow read, write: if isStaff();
    }
    
    match /system_counters/{counterId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /sales_stats/{statId} {
      allow read, write: if isStaff();
    }
    
    match /system_accounts/{accountId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    // 7. รีวิวสินค้า (Product Reviews - Quota & Spam Guard)
    match /product_reviews/{reviewId} {
      // เปิดให้อ่านสาธารณะ สำหรับแสดงความคิดเห็นสินค้า
      allow read: if true;
      // อนุญาตให้ผู้ใช้ที่ล็อกอินแล้วเพิ่มรีวิว (ตรวจสอบ Rating 1-5 และ userId ตรงกับตัวเอง)
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 2000;
      // อนุญาตให้อัปเดต likes/helpful (หรือเจ้าของแก้ไข หรือ Staff)
      allow update: if isAuthenticated() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'helpful', 'likeCount', 'likesCount'])) ||
        (resource.data.userId == request.auth.uid) ||
        isStaff()
      );
      // อนุญาตให้ลบเฉพาะเจ้าของรีวิว หรือ Staff
      allow delete: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 🚀 THE FIX: อนุญาตให้ดึงข้อมูลประวัติกระเป๋าเงินผ่าน collectionGroup ได้ สำหรับ Manager/Staff (Audit Ledger)
    match /{path=**}/wallet_transactions/{txId} {
      allow read: if isStaff();
    }
  }
}

