rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ ฟังก์ชันตรวจสอบ Role (ใช้ Custom Claims เป็นหลักเพื่อลด Quota Read, ไม่ Fallback ไปหา DB แล้วเพื่อป้องกัน Read Cost มหาศาลจาก User ทั่วไป)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        request.auth.token.role == 'manager' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner' ||
        request.auth.token.isStaff == true ||
        request.auth.uid == '8rP6WhimrqOILBId86bkTsvNHFf1' ||
        request.auth.token.email == 'ai.manager@dhnotebook.com'
      );
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'manager' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner' ||
        request.auth.uid == '8rP6WhimrqOILBId86bkTsvNHFf1' ||
        request.auth.token.email == 'ai.manager@dhnotebook.com'
      );
    }
    
    // ============================================
    // 🌟 กฎของ Collections ต่างๆ
    // ============================================

    // 1. ผู้ใช้ (Users)
    match /users/{userId} {
      // สงวนสิทธิ์การอ่านข้อมูลส่วนบุคคลเฉพาะเจ้าของและพนักงานเท่านั้น (PDPA Compliance)
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      
      // 🚀 THE FIX: ป้องกันการแฮกยกระดับสิทธิ์และแก้ไขยอดเงิน (Escalation of Privilege & Financial Fraud)
      allow create: if isStaff() || (isAuthenticated() && request.auth.uid == userId);
      allow update: if isStaff() || (
        isAuthenticated() && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isStaff', 'uid', 'creditPoints', 'totalAccumulatedPoints', 
          'rank', 'accountId', 'customerCode', 'isActive', 'status'
        ])) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stats']) || (
          request.resource.data.get('stats', {}).diff(resource.data.get('stats', {})).affectedKeys().hasOnly(['lastOrderDate', 'lastPurchaseDate'])
        )) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'pendingWithdrawal']) ||
          (
            request.resource.data.get('walletBalance', 0) < resource.data.get('walletBalance', 0) &&
            request.resource.data.get('walletBalance', 0) >= 0 &&
            (
              request.resource.data.get('pendingWithdrawal', 0) == resource.data.get('pendingWithdrawal', 0) ||
              request.resource.data.get('pendingWithdrawal', 0) == resource.data.get('pendingWithdrawal', 0) + (resource.data.get('walletBalance', 0) - request.resource.data.get('walletBalance', 0))
            )
          )
        )
      );
      
      // 🛡️ ปลอดภัยระดับสูงสุด: แยกแยะสิทธิ์ Subcollections ป้องกันการแก้ไขประวัติธุรกรรมและการแฮก Legacy Wallet
      match /wallet_transactions/{txId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        allow create: if isStaff();
        allow update, delete: if isStaff();
      }
      match /historyLogs/{logId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if isStaff();
      }
      match /hardware_scans/{scanId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
      match /wallet/{walletId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        allow write: if isStaff();
      }
      match /storeProfile/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
    }
    
    // 1.1 ผู้ใช้ (Users) ในระบบ Artifacts
    match /artifacts/{appId}/users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isStaff() || (
        isAuthenticated() && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isStaff', 'uid', 'creditPoints', 'totalAccumulatedPoints', 
          'rank', 'accountId', 'customerCode', 'isActive', 'status'
        ])) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stats']) || (
          request.resource.data.get('stats', {}).diff(resource.data.get('stats', {})).affectedKeys().hasOnly(['lastOrderDate', 'lastPurchaseDate'])
        )) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'pendingWithdrawal']) ||
          (
            request.resource.data.get('walletBalance', 0) < resource.data.get('walletBalance', 0) &&
            request.resource.data.get('walletBalance', 0) >= 0 &&
            (
              request.resource.data.get('pendingWithdrawal', 0) == resource.data.get('pendingWithdrawal', 0) ||
              request.resource.data.get('pendingWithdrawal', 0) == resource.data.get('pendingWithdrawal', 0) + (resource.data.get('walletBalance', 0) - request.resource.data.get('walletBalance', 0))
            )
          )
        )
      );
      
      // 🛡️ ปลอดภัยระดับสูงสุดสำหรับระบบ Artifacts
      match /wallet_transactions/{txId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        allow create: if isStaff();
        allow update, delete: if isStaff();
      }
      match /hardware_scans/{scanId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
      match /wallet/{walletId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
        allow write: if isStaff();
      }
      match /storeProfile/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      }
    }

    // 2. สินค้าคงคลัง (Products)
    match /products/{productId} {
      // ลูกค้าทั่วไปอ่านได้
      allow read: if true;
      // เฉพาะพนักงานเท่านั้นที่แก้ไขจำนวนสต๊อก หรือข้อมูลทั้งหมดได้
      allow write: if isStaff();
      // 🚀 THE FIX (Inventory DoS): ป้องกันคนนอกยิง API แกล้งลดสต๊อกจนหมด
      allow update: if isStaff() || (isAuthenticated() && 
                    request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['reviewCount', 'averageRating', 'stockQuantity', 'stats']) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockQuantity']) || (
                        request.resource.data.get('stockQuantity', 0) >= 0 &&
                        request.resource.data.get('stockQuantity', 0) >= (resource.data.get('stockQuantity', 0) - 100) &&
                        request.resource.data.get('stockQuantity', 0) <= resource.data.get('stockQuantity', 0) // ห้ามเพิ่มสต๊อกเอง
                    )));
    }

    // 2.1 รีวิวสินค้า (Product Reviews)
    match /product_reviews/{reviewId} {
      allow read: if true; // ทุกคนอ่านรีวิวได้
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; // ต้องล็อกอินถึงจะเขียนรีวิวได้
      allow update: if isAuthenticated(); // สำหรับการกด Like
      allow delete: if isManagerOrAdmin(); // เฉพาะผู้ดูแลลบได้
    }

    // 3. ระบบบิลและการเงิน (Orders & Credit)
    match /orders/{orderId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.customer.uid == request.auth.uid));
      // 🚀 THE FIX: บังคับให้สร้างออเดอร์ในสถานะเริ่มต้นเท่านั้น ป้องกันการโกงสลิป และจำกัด pendingCredits (Defense in Depth)
      allow create: if isStaff() || (
        isAuthenticated() && request.resource.data.userId == request.auth.uid &&
        (!request.resource.data.keys().hasAll(['paymentStatus']) || request.resource.data.paymentStatus == 'pending') &&
        (!request.resource.data.keys().hasAll(['isPaid']) || request.resource.data.isPaid == false) &&
        (!request.resource.data.keys().hasAll(['pendingCredits']) || request.resource.data.pendingCredits <= (request.resource.data.get('totals', {}).get('netTotal', 0) + 10000))
      );
      allow update: if isStaff() || (
        isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderStatus', 'receivedAt', 'cancelledBy', 'cancelledAt', 'updatedAt', 'pendingCredits']) &&
        (
          (request.resource.data.status == 'received' && resource.data.status in ['shipped', 'completed', 'approved', 'paid']) ||
          (request.resource.data.status == 'cancelled' && resource.data.status in ['pending', 'pending_payment'])
        )
      );
      allow delete: if isStaff();
    }

    match /credit_transactions/{txId} {
      // ลูกค้าดูประวัติกระเป๋าเงินตัวเองได้
      allow read: if isStaff() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      // เฉพาะระบบและพนักงานเขียนได้
      allow write: if isStaff();
    }

    // 4. งานอนุมัติของ Manager (Todos & System Logs)
    match /todos/{todoId} {
      allow read: if isStaff() || (isAuthenticated() && (
        resource == null ||
        resource.data.createdByUid == request.auth.uid || 
        resource.data.createdBy == request.auth.uid || 
        resource.data.customerUid == request.auth.uid || 
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      ));
      allow create: if isStaff() || (isAuthenticated() && (
        request.resource.data.createdByUid == request.auth.uid || 
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.partnerId == request.auth.uid
      ) && (
        // 🚀 THE FIX: บังคับสถานะ Todo ให้เป็น pending หรือ todo เท่านั้น ป้องกันแฮกสร้างงานที่ผ่านการอนุมัติแล้ว
        request.resource.data.status in ['todo', 'pending', 'waiting_item', 'PENDING']
      ) && (
        // 🛡️ ป้องกันแฮกเกอร์แอบสร้างงานสงวนสิทธิ์ของพนักงาน/ผู้จัดการ
        !(request.resource.data.get('taskType', '') in [
          'CLAIM_APPROVAL', 'RETURN_APPROVAL', 'CANCEL_CLAIM_APPROVAL', 
          'CANCEL_RETURN_APPROVAL', 'PRODUCT_DELETE_APPROVAL', 'STAFF_APPROVAL', 
          'PARTNER_APPROVAL', 'PRODUCT_KNOWLEDGE_APPROVAL', 'BILL_CANCEL_APPROVAL',
          'WALLET_WITHDRAWAL'
        ]) &&
        !(request.resource.data.get('type', '') in [
          'CLAIM_APPROVAL', 'RETURN_APPROVAL', 'CANCEL_CLAIM_APPROVAL', 
          'CANCEL_RETURN_APPROVAL', 'PRODUCT_DELETE_APPROVAL', 'STAFF_APPROVAL', 
          'PARTNER_APPROVAL', 'PRODUCT_KNOWLEDGE_APPROVAL', 'BILL_CANCEL_APPROVAL',
          'WALLET_WITHDRAWAL'
        ])
      ));
      allow update: if isStaff() || (isAuthenticated() && (
        resource == null ||
        resource.data.createdByUid == request.auth.uid || 
        resource.data.createdBy == request.auth.uid || 
        resource.data.customerUid == request.auth.uid || 
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.partnerId == request.auth.uid
      ) && (
        // 🚀 THE FIX: ห้ามแก้สถานะหรือจำนวนเงินหลังสร้างเสร็จ
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'type', 'amount', 'completedAt'])
      ));
      allow delete: if isStaff() || (isAuthenticated() && (
        resource == null ||
        resource.data.createdByUid == request.auth.uid || 
        resource.data.createdBy == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      ));
    }
    
    match /system_logs/{logId} {
      allow read: if isManagerOrAdmin();
      allow write: if isManagerOrAdmin();
    }
    
    match /artifacts/{appId}/system_logs/{logId} {
      allow read: if isManagerOrAdmin();
      allow write: if isManagerOrAdmin();
    }

    // 5. ข้อมูลอื่นๆ ที่เป็น Public (หมวดหมู่, หน้าแรก, โฆษณา)
    match /artifacts/{appId}/public/{document=**} {
      allow read: if true;
      allow create: if isAuthenticated(); // 🚀 THE FIX: ให้สิทธิ์แค่สร้าง ไม่ให้เขียนทับของคนอื่น (ป้องกัน DoS)
      allow update, delete: if isStaff();
    }
    match /homepage_categories/{catId} {
      allow read: if true;
      allow write: if isManagerOrAdmin();
    }
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isStaff() || (isAuthenticated() && request.auth.uid == partnerId);
    }
    match /ActivePartners/{partnerId} {
      allow read: if true;
      allow write: if isManagerOrAdmin(); // อนุมัติโดยระบบ
    }
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /freebies/{freebieId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    // 5.1 ข้อมูลโฆษณาต่างๆ (Ads)
    match /partner_ads/{adId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }
    match /billboard_ads/{adId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }
    match /user_sku_ads/{adId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }
    
    // 6. การตั้งค่าระบบ (Settings) และข้อมูลพื้นฐาน
    match /carts/{cartId} {
      allow read, write: if isAuthenticated() && request.auth.uid == cartId;
    }
    match /shipping_rules/{docId} {
      allow read: if true;
      allow write: if isManagerOrAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isManagerOrAdmin();
    }
    
    match /system_config/{docId} {
      // ป้องกันการเข้าถึง Token/Secret ยกเว้น Manager
      allow read, write: if isManagerOrAdmin();
    }
    
    match /counters/{counterId} {
      allow read, write: if isStaff();
    }
    
    match /system_counters/{counterId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /sales_stats/{statId} {
      allow read, write: if isStaff();
    }
    
    match /system_accounts/{accountId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    // 🚀 THE FIX: อนุญาตให้ดึงข้อมูลประวัติกระเป๋าเงินผ่าน collectionGroup ได้ สำหรับ Manager/Staff (Audit Ledger)
    match /{path=**}/wallet_transactions/{txId} {
      allow read: if isStaff();
    }
  }
}
