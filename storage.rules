rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        request.auth.token.role == 'manager' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner' ||
        request.auth.token.isStaff == true
      );
    }

    // 1. ภาพสลิปโอนเงิน (Slips)
    match /slips/{fileName} {
      allow read: if isStaff();
      // ลูกค้าหรือพนักงานอัปโหลดได้ แต่ห้ามอัปเดตทับไฟล์เดิมเด็ดขาด (จำกัดเฉพาะ WebP/JPEG/PNG ขนาดไม่เกิน 2MB)
      allow write: if isAuthenticated() && resource == null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    // 2. รูปภาพสินค้าและหน้าเว็บ (Public Assets)
    match /products/{fileName} {
      allow read: if true;
      allow write: if isStaff()
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }
    
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff()
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    
    // 3. รูปภาพโปรไฟล์พนักงานและคู่ค้า
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }
    
    // 4. ค่าเริ่มต้นบล็อกไฟล์ที่ไม่ได้ระบุไว้
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
